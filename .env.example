POSTGRES_USER=dbuser
POSTGRES_PASSWORD=dbpassword
POSTGRES_DB=dbname

# Utilisé uniquement en dev local hors Docker (le compose de prod calcule
# DATABASE_URL lui-même à partir des 3 variables POSTGRES_* ci-dessus).
DATABASE_URL="postgresql://user:password@localhost:5432/name?schema=public"

PORT=3000
# En production : domaine public exact du frontend, jamais de wildcard.
CORS_ORIGIN=https://votre-domaine.fr
FRONTEND_URL=https://votre-domaine.fr

VITE_API_URL=/api

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
CONTACT_TO=your-email@gmail.com
